{
  "name": "h3core",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run --config tests/vitest.config.ts",
    "test:modules": "vitest run && vitest run --config src/adventure/vitest.config.ts && vitest run --config src/battle/vitest.config.ts && vitest run --config src/ui/vitest.config.ts",
    "test:e2e": "npm run build && node tests/browser-smoke.mjs",
    "docs:generate": "node scripts/generate-content-docs.mjs",
    "docs:check": "node scripts/generate-content-docs.mjs --check"
  },
  "dependencies": {
    "three": "^0.174.0"
  },
  "devDependencies": {
    "@types/three": "^0.174.0",
    "typescript": "~5.7.2",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  }
}
